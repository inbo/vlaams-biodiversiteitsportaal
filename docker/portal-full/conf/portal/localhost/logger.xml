<?xml version="1.0" encoding="UTF-8"?>
<Context reloadable="false" useHttpOnly="false">

    <Parameter name="spring.config.additional-location"
               value="file:/config/common/common.yml,file:/config/logger/logger.yml,${ADDITIONAL_SPRING_CONFIG_LOCATIONS}"
               override="false"/>
    <Parameter name="grails.env"
               value="${GRAILS_ENV}"
               override="false"/>

    <!-- logger 4.7.0 bundles spring-boot-cli, whose SpringApplicationWebApplicationInitializer fails in an
         external Tomcat (NPE on the missing Spring-Application-Source-Classes manifest entry).
         Keep that jar out of the servlet container initializer scan. -->
    <JarScanner>
        <JarScanFilter pluggabilitySkip="spring-boot-cli-*.jar"/>
    </JarScanner>

    <!-- Logging config -->
    <Parameter name="appName"
               value="%boldYellow(logger)"
               override="false"/>
</Context>