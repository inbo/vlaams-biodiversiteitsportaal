+    private Map addExtraConservationLists(Map threatened) {
+        if (StringUtils.isBlank(additionalConservationLists)) {
+            return threatened;
+        }
+
+        if (threatened == null) {
+            threatened = new HashMap();
+        }
+
+        List lists = (List) threatened.get("lists");
+        if (lists == null) {
+            lists = new ArrayList();
+            threatened.put("lists", lists);
+        }
+
+        Set<String> existingUids = new HashSet<String>();
+        for (Object o : lists) {
+            if (o instanceof Map) {
+                Object uid = ((Map) o).get("dataResourceUid");
+                if (uid != null) {
+                    existingUids.add(uid.toString());
+                }
+            }
+        }
+
+        for (String uid : additionalConservationLists.split(",")) {
+            String trimmedUid = StringUtils.trimToEmpty(uid);
+            if (StringUtils.isBlank(trimmedUid) || existingUids.contains(trimmedUid)) {
+                continue;
+            }
+
+            try {
+                SpeciesListDTO listInfo = getListInfo(trimmedUid);
+                if (listInfo != null && StringUtils.isNotBlank(listInfo.dataResourceUid)) {
+                    Map list = new HashMap();
+                    list.put("listName", listInfo.listName);
+                    list.put("dataResourceUid", listInfo.dataResourceUid);
+                    lists.add(list);
+                    existingUids.add(listInfo.dataResourceUid);
+                }
+            } catch (Exception e) {
+                logger.error("failed to add configured conservation list: " + trimmedUid, e);
+            }
+        }
+
+        return threatened;
+    }
